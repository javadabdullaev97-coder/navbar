{
  "expo": {
    "name": "ORA",
    "slug": "ora-client",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "ora",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#FCF9F8",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#5E1226"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "uz.ora.client"
    },
    "android": {
      "package": "uz.ora.client",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5E1226"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        { "photosPermission": "Разрешите доступ к фото, чтобы загрузить аватар, портфолио и документы." }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
